# EmailJS credentials for the contact form (src/components/ContactFormModal.tsx).
# Get these from https://dashboard.emailjs.com/admin
# The public key is safe to expose client-side; EmailJS enforces restrictions
# (allowed domains, template scope) from their dashboard, not by hiding this value.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
